          "id": "scale",
          "port_type": "inlet",
          "order": 2
        },
        "recipe": {
          "registry_key": "haywire-core:type:FLOAT"
        }
      },
      "tile_size": {
        "kwargs": {
          "label": "Tile Size",
          "description": "Tile edge in pixels; auto fits the memory, none runs the whole image at once",
          "default": {
            "value": "auto"
          },
          "store_strategy": 4,
          "widget_key": "haywire-core:widget:MenuWidget",
          "widget_config": {
            "properties": {
              "options": [
                "auto",
                "none",
                "128",
                "256",
                "512",
                "1024"
              ],
              "new_value_mode": "add-unique"
            }
          },
          "id": "tile_size",
          "port_type": "config",
          "order": 3,
          "show_widget": "always"
        },
        "recipe": {
          "registry_key": "haywire-core:type:STRING"
        }
      },
      "alpha": {
        "kwargs": {
          "label": "Alpha",
          "description": "Alpha channel: resize scales it smoothly, model runs it through the model",
          "default": {
            "value": "resize"
          },
          "store_strategy": 4,
          "widget_key": "haywire-core:widget:MenuWidget",
          "widget_config": {
            "properties": {
              "options": [
                "resize",
                "model"
              ]
            }
          },
          "id": "alpha",
          "port_type": "config",
          "order": 4,
          "show_widget": "always"
        },
        "recipe": {
          "registry_key": "haywire-core:type:STRING"
        }
      },
      "out_image": {
        "kwargs": {
          "description": "The processed image",
          "id": "out_image",
          "port_type": "outlet",
          "order": 5,
          "show_widget": "never"
        },
        "recipe": {
          "registry_key": "haybale-image:type:IMAGE"
        }
      }
    }
