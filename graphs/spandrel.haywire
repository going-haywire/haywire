        }
      },
      "path": {
        "kwargs": {
          "label": "Path",
          "description": "File to write; its extension picks the format",
          "store_strategy": 2,
          "widget_config": {
            "properties": {
              "mode": "save",
              "extensions": [
                ".png",
                ".jpg",
                ".jpeg",
                ".jpe",
