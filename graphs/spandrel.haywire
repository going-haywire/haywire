                "16",
                "32"
              ]
            }
          },
          "id": "depth",
          "port_type": "config",
          "order": 4,
          "show_widget": "always"
        },
        "recipe": {
          "registry_key": "haywire-core:type:STRING"
        }
      },
      "next": {
        "kwargs": {
          "label": "Next",
