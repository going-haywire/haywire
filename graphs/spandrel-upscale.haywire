    "haybale-image:node:SaveImageNode": {
      "exec": {
        "kwargs": {
          "label": "Execute",
          "description": "Saves the image",
          "id": "exec",
          "port_type": "inlet"
        },
        "recipe": {
          "registry_key": "haywire-core:type:EXEC"
        }
      },
      "image": {
        "kwargs": {
          "description": "Image to save",
          "id": "image",
          "port_type": "inlet",
          "order": 1
        },
        "recipe": {
          "registry_key": "haybale-image:type:IMAGE"
        }
      },
      "path": {
        "kwargs": {
          "label": "Path",
          "description": "File to write; its extension picks the format",
          "store_strategy": 2,
          "widget_config": {
            "properties": {
              "mode": "save",
              "extensions": [
                ".png",
                ".jpg",
                ".jpeg",
                ".jpe",
                ".webp",
                ".tif",
                ".tiff",
                ".bmp",
                ".gif",
                ".tga",
                ".avif"
              ]
            }
          },
          "id": "path",
          "port_type": "inlet",
          "order": 2,
          "on_change": "hb_on_path_changed"
        },
        "recipe": {
          "registry_key": "haywire-core:type:FILE_PATH"
        }
      },
      "if_exists": {
        "kwargs": {
          "label": "If Exists",
          "description": "When the file exists: overwrite, skip, or unique-suffix (adds a number)",
          "default": {
            "value": "overwrite"
          },
          "store_strategy": 4,
          "widget_key": "haywire-core:widget:MenuWidget",
          "widget_config": {
            "properties": {
              "options": [
                "overwrite",
                "skip",
                "unique-suffix"
              ]
            }
          },
          "id": "if_exists",
          "port_type": "config",
          "order": 3,
          "show_widget": "always"
        },
        "recipe": {
          "registry_key": "haywire-core:type:STRING"
        }
      },
      "depth": {
        "kwargs": {
          "label": "Depth",
          "description": "Bits per channel: source keeps the image's own, or 8, 16, 32",
          "default": {
            "value": "source"
          },
          "store_strategy": 4,
          "widget_key": "haywire-core:widget:MenuWidget",
          "widget_config": {
            "properties": {
              "options": [
                "source",
                "8",
                "16",
                "32"
              ]
            }
          },
          "id": "depth",
          "port_type": "config",
          "order": 4,
          "show_widget": "always"
        },
        "recipe": {
          "registry_key": "haywire-core:type:STRING"
        }
      },
      "next": {
        "kwargs": {
          "label": "Next",
          "description": "Runs after saving",
          "id": "next",
          "port_type": "outlet",
          "order": 5,
          "show_widget": "never"
        },
        "recipe": {
          "registry_key": "haywire-core:type:EXEC"
        }
      },
      "saved": {
        "kwargs": {
          "label": "Saved",
          "description": "The file written, or the one skipped",
          "store_strategy": 4,
          "id": "saved",
          "port_type": "outlet",
          "order": 6,
          "show_widget": "never"
        },
        "recipe": {
          "registry_key": "haywire-core:type:FILE_PATH"
        }
      }
    },
