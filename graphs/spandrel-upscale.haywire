    "haybale-spandrel:node:UpscaleImageNode": {
      "image": {
        "kwargs": {
          "description": "Image to process",
          "id": "image",
          "port_type": "inlet"
        },
        "recipe": {
          "registry_key": "haybale-image:type:IMAGE"
        }
      },
      "model": {
        "kwargs": {
          "label": "Model",
          "description": "A loaded image-to-image model",
          "id": "model",
          "port_type": "inlet",
          "order": 1
        },
        "recipe": {
          "registry_key": "haybale-spandrel:type:IMAGE_MODEL"
        }
      },
      "scale": {
        "kwargs": {
          "label": "Scale",
          "description": "Size of the result relative to the input; 0 is the model's own scale",
          "store_strategy": 2,
          "id": "scale",
          "port_type": "inlet",
          "order": 2
        },
        "recipe": {
          "registry_key": "haywire-core:type:FLOAT"
        }
      },
      "tile_size": {
        "kwargs": {
          "label": "Tile Size",
          "description": "Tile edge in pixels; auto fits the memory, none runs the whole image at once",
          "default": {
            "value": "auto"
          },
          "store_strategy": 4,
          "widget_key": "haywire-core:widget:MenuWidget",
          "widget_config": {
            "properties": {
              "options": [
                "auto",
                "none",
                "128",
                "256",
                "512",
                "1024"
              ],
              "new_value_mode": "add-unique"
            }
          },
          "id": "tile_size",
          "port_type": "config",
          "order": 3,
          "show_widget": "always"
        },
        "recipe": {
          "registry_key": "haywire-core:type:STRING"
        }
      },
      "alpha": {
        "kwargs": {
          "label": "Alpha",
          "description": "Alpha channel: resize scales it smoothly, model runs it through the model",
          "default": {
            "value": "resize"
          },
          "store_strategy": 4,
          "widget_key": "haywire-core:widget:MenuWidget",
          "widget_config": {
            "properties": {
              "options": [
                "resize",
                "model"
