# Anthropic key for the Pi agent — required for the `claude` variant.
ANTHROPIC_API_KEY=
# Pi model id override for the `claude` variant (optional; defaults to
# claude-opus-4-8 in main.mts). The `qwen` variant ignores this — its model
# is fixed to ollama/qwen3-coder:30b (see Dockerfile / README.md).
PI_MODEL=
# Not needed for the local-ticket loop (docker() bind-mounts the repo; no
# clone/push happens). Kept for workflows that talk to GitHub.
GH_TOKEN=
